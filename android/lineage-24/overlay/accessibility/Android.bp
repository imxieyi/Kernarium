// TalkBack, Android's screen reader, and eSpeak NG, the voice it speaks with.
// The APKs are the accessibility artifact that build-aosp.sh stages as the
// filegroups of vendor/kernarium/accessibility
// (tools/stage-accessibility-artifact.py); they arrive unsigned, and the build
// and the release signing sign them as any application of the image.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_import {
    name: "TalkBack",
    apk: ":kernarium_accessibility_talkback",
    default_dev_cert: true,
    product_specific: true,
}

android_app_import {
    name: "eSpeakNG",
    apk: ":kernarium_accessibility_espeak_ng",
    default_dev_cert: true,
    product_specific: true,
}
